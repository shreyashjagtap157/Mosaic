<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Mosaic Compressor"
    Manufacturer="Mosaic"
    Version="0.1.3.3"
    UpgradeCode="{7C9E2F13-2D7F-4B6A-9F0A-42D8C2B32D61}"
    Language="1033"
    InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Mosaic Compressor is already installed." />
    <MediaTemplate />

    <Feature Id="MainFeature" Title="Mosaic Compressor" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Mosaic Compressor" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramsFolder" Name="Mosaic Compressor" />
    </StandardDirectory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="cmpDesktopExe" Guid="{B5B9E7D8-ED4D-44D3-97D4-3B4C0A2E5D78}">
        <File Source="$(var.MosaicDesktopTargetPath)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AppProgramsFolder">
      <Component Id="cmpStartMenuShortcut" Guid="{7D84C90A-61A6-46F6-9A32-96A7B1C2A7A3}">
        <Shortcut
          Id="MosaicDesktopShortcut"
          Name="Mosaic Compressor"
          Description="Mosaic desktop file compressor"
          Target="[INSTALLFOLDER]mosaic-desktop.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Mosaic\MosaicCompressor" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="AppComponents">
      <ComponentRef Id="cmpDesktopExe" />
      <ComponentRef Id="cmpStartMenuShortcut" />
    </ComponentGroup>
  </Package>
</Wix>
